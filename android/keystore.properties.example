# Copie para android/keystore.properties (que o git ignora) e preencha com os SEUS dados.
# Caminho relativo à pasta android/app ou absoluto. Guarde o arquivo .jks fora do repositório e com backup.
storeFile=/caminho/seguro/flowfactory-upload.jks
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=upload
keyPassword=SUA_SENHA_DA_CHAVE
